// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id
  name             String
  email            String
  emailVerified    Boolean      @default(false)
  image            String?      @default("http://localhost:3000/assets/users/user_o25.png")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  twoFactorEnabled Boolean?     @default(false)
  lastLoginMethod  String?
  role             String?
  banned           Boolean?     @default(false)
  banReason        String?
  banExpires       DateTime?
  stripeCustomerId String?
  accessType       Int?         @default(0)
  defaultWorkspace String?
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  passkeys         Passkey[]
  members          Member[]
  invitations      Invitation[]

  creemCustomerId String?
  hadTrial        Boolean? @default(false)
  workspacesCount Int?     @default(1)
  workspacesLimit Int?     @default(2)

  projectMembers ProjectMember[]
  contextsCreated Context[] @relation("ContextCreatedBy")
  contextsUpdated Context[] @relation("ContextUpdatedBy")
  contextVersionsCreated ContextVersion[] @relation("ContextVersionCreatedBy")

  instructionsCreated Instruction[] @relation("InstructionCreatedBy")
  instructionsUpdated Instruction[] @relation("InstructionUpdatedBy")
  instructionVersionsCreated InstructionVersion[] @relation("InstructionVersionCreatedBy")

  skillsCreated Skill[] @relation("SkillCreatedBy")
  skillsUpdated Skill[] @relation("SkillUpdatedBy")
  skillVersionsCreated SkillVersion[] @relation("SkillVersionCreatedBy")

  promptTemplatesCreated PromptTemplate[] @relation("PromptTemplateCreatedBy")
  promptTemplatesUpdated PromptTemplate[] @relation("PromptTemplateUpdatedBy")
  promptTemplateVersionsCreated PromptTemplateVersion[] @relation("PromptTemplateVersionCreatedBy")

  checklistsCreated Checklist[] @relation("ChecklistCreatedBy")
  checklistsUpdated Checklist[] @relation("ChecklistUpdatedBy")
  checklistVersionsCreated ChecklistVersion[] @relation("ChecklistVersionCreatedBy")

  agentProfilesCreated AgentProfile[] @relation("AgentProfileCreatedBy")
  agentProfilesUpdated AgentProfile[] @relation("AgentProfileUpdatedBy")

  projectApiKeysCreated ProjectApiKey[] @relation("ProjectApiKeyCreatedBy")
  mcpIdentitiesCreated McpIdentity[] @relation("McpIdentityCreatedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Organization {
  id        String   @id
  name      String
  slug      String
  logo      String?
  createdAt DateTime
  metadata  String?
  plan      String?  @default("Free")

  creemId               String?
  systemTokenLimit      Int?         @default(100)
  systemTokenUsage      Int?         @default(0)
  imageTokenLimit       Int?         @default(0)
  imageTokenUsage       Int?         @default(0)
  usersCount            Int?         @default(1)
  usersLimit            Int?         @default(0)
  additionalSystemToken Int?         @default(0)
  additionalImageToken  Int?         @default(0)
  lastResetDate         DateTime?    @default(now())
  nextResetDate         DateTime?
  updatedAt             DateTime     @updatedAt
  members               Member[]
  invitations           Invitation[]

  additionalSystemTokenUsage Int? @default(0)
  additionalImageTokenUsage  Int? @default(0)

  projects Project[]
  mcpIdentities McpIdentity[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@map("subscription")
}

model TokenUsageLog {
  id           String   @id @default(cuid())
  workspaceId  String
  date         DateTime
  systemTokens Int      @default(0)
  imageTokens  Int      @default(0)

  @@unique([workspaceId, date])
  @@index([workspaceId, date])
  @@map("token_usage_logs")
}

// workspace model

model Audit {
  id          String   @id @default(cuid())
  workspaceId String
  action      String
  actorId     String
  actorType   String   @default("member")
  actorName   String   @default("system")
  description String   @default("")
  timestamp   DateTime // JSON type replaces Array/Mixed from MongoDB
  targets     Json     @default("[]")
  metadata    Json?
  ipAddress   String   @default("")
  userAgent   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([createdAt])
  @@map("audits")
}

model Creem_subscription {
  id                  String    @id
  productId           String
  referenceId         String
  creemCustomerId     String?
  creemSubscriptionId String?
  creemOrderId        String?
  status              String    @default("pending")
  periodStart         DateTime?
  periodEnd           DateTime?
  cancelAtPeriodEnd   Boolean?  @default(false)

  @@map("creem_subscription")
}

model TopUpPurchase {
  id          String   @id @default(cuid())
  workspaceId String
  amount      Int // dollars paid (e.g. 5, 10, 20, 50, 100)
  tokens      Int // tokens received
  tokenType   String // "system" | "image"
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@map("top_up_purchases")
}

model Project {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  status         String    @default("active") // "active" | "archived"
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  members        ProjectMember[]
  contexts       Context[]
  instructions   Instruction[]
  skills         Skill[]
  promptTemplates PromptTemplate[]
  checklists     Checklist[]
  agentProfiles  AgentProfile[]
  activities     ProjectActivity[]
  apiKeys        ProjectApiKey[]
  mcpIdentityGrants McpIdentityResourceGrant[]
  mcpRequestLogs McpRequestLog[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("project")
}

model Context {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  content     String   @db.Text
  status      String   @default("draft") // "draft" | "published"
  version     Int      @default(1)
  createdById String
  createdBy   User     @relation("ContextCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("ContextUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    ContextVersion[]
  mainVersionId String?          @unique
  mainVersion   ContextVersion?  @relation("ContextMainVersion", fields: [mainVersionId], references: [id])

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([projectId, status])
  @@map("context")
}

model ContextVersion {
  id          String   @id @default(cuid())
  contextId   String
  context     Context  @relation(fields: [contextId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  description String?
  content     String   @db.Text
  createdById String
  createdBy   User     @relation("ContextVersionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  mainForContext Context? @relation("ContextMainVersion")

  @@unique([contextId, version])
  @@index([contextId])
  @@map("context_version")
}

model Instruction {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  content     String   @db.Text
  status      String   @default("draft") // "draft" | "published"
  version     Int      @default(1)
  createdById String
  createdBy   User     @relation("InstructionCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("InstructionUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    InstructionVersion[]
  mainVersionId String?             @unique
  mainVersion   InstructionVersion? @relation("InstructionMainVersion", fields: [mainVersionId], references: [id])

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([projectId, status])
  @@map("instruction")
}

model InstructionVersion {
  id            String   @id @default(cuid())
  instructionId String
  instruction   Instruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  version       Int
  title         String
  description   String?
  content       String   @db.Text
  createdById   String
  createdBy     User     @relation("InstructionVersionCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  mainForInstruction Instruction? @relation("InstructionMainVersion")

  @@unique([instructionId, version])
  @@index([instructionId])
  @@map("instruction_version")
}

model Skill {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  content     String   @db.Text
  status      String   @default("draft") // "draft" | "published"
  version     Int      @default(1)
  createdById String
  createdBy   User     @relation("SkillCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("SkillUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    SkillVersion[]
  mainVersionId String?        @unique
  mainVersion   SkillVersion?  @relation("SkillMainVersion", fields: [mainVersionId], references: [id])

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([projectId, status])
  @@map("skill")
}

model SkillVersion {
  id          String   @id @default(cuid())
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  description String?
  content     String   @db.Text
  createdById String
  createdBy   User     @relation("SkillVersionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  mainForSkill Skill?  @relation("SkillMainVersion")

  @@unique([skillId, version])
  @@index([skillId])
  @@map("skill_version")
}

model PromptTemplate {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  content     String   @db.Text
  status      String   @default("draft") // "draft" | "published"
  version     Int      @default(1)
  createdById String
  createdBy   User     @relation("PromptTemplateCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("PromptTemplateUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    PromptTemplateVersion[]
  mainVersionId String?                 @unique
  mainVersion   PromptTemplateVersion?  @relation("PromptTemplateMainVersion", fields: [mainVersionId], references: [id])

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([projectId, status])
  @@map("prompt_template")
}

model PromptTemplateVersion {
  id               String   @id @default(cuid())
  promptTemplateId String
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)
  version          Int
  title            String
  description      String?
  content          String   @db.Text
  createdById      String
  createdBy        User     @relation("PromptTemplateVersionCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  mainForPromptTemplate PromptTemplate? @relation("PromptTemplateMainVersion")

  @@unique([promptTemplateId, version])
  @@index([promptTemplateId])
  @@map("prompt_template_version")
}

model LibraryTemplate {
  id                    String   @id @default(cuid())
  source                String   @default("awesome-copilot")
  sourcePath            String
  sourceCategory        String // "instruction" | "agent" | "skill" | "workflow" | "cookbook" | "plugin" | "hook"
  sourceUrl             String
  title                 String
  description           String?
  tags                  String[] @default([])
  content               String   @db.Text
  frontmatter           Json?
  contentHash           String
  suggestedResourceType String // "context" | "instruction" | "skill" | "promptTemplate" | "checklist"
  lastSyncedAt          DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@unique([source, sourcePath])
  @@index([source, sourceCategory])
  @@map("library_template")
}

model Checklist {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  content     String   @db.Text
  status      String   @default("draft") // "draft" | "published"
  version     Int      @default(1)
  createdById String
  createdBy   User     @relation("ChecklistCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("ChecklistUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    ChecklistVersion[]
  mainVersionId String?            @unique
  mainVersion   ChecklistVersion?  @relation("ChecklistMainVersion", fields: [mainVersionId], references: [id])

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([projectId, status])
  @@map("checklist")
}

model ChecklistVersion {
  id          String   @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  description String?
  content     String   @db.Text
  createdById String
  createdBy   User     @relation("ChecklistVersionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  mainForChecklist Checklist? @relation("ChecklistMainVersion")

  @@unique([checklistId, version])
  @@index([checklistId])
  @@map("checklist_version")
}

model AgentProfile {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  status      String   @default("draft") // "draft" | "published"
  createdById String
  createdBy   User     @relation("AgentProfileCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("AgentProfileUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resources   AgentProfileResource[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("agent_profile")
}

model AgentProfileResource {
  id             String   @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  resourceType   String   // "context" | "instruction" | "skill" | "prompt_template" | "checklist"
  resourceId     String
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([agentProfileId, resourceType, resourceId])
  @@index([agentProfileId])
  @@map("agent_profile_resource")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // "owner" | "member" | "viewer"
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_member")
}

model ProjectActivity {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId       String
  actorName     String
  action        String
  resourceType  String?
  resourceId    String?
  resourceTitle String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, resourceType])
  @@map("project_activity")
}

model ProjectApiKey {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mcpIdentityId String
  mcpIdentity   McpIdentity @relation(fields: [mcpIdentityId], references: [id], onDelete: Cascade)
  name          String
  keyPrefix     String
  keyHash       String
  secret        String? // raw key, stored (unlike keyHash-only PAT convention) so owners/moderators can re-copy a full client config later; null for keys created before this field existed
  createdById   String
  createdBy     User        @relation("ProjectApiKeyCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  @@index([projectId])
  @@index([mcpIdentityId])
  @@index([keyPrefix])
  @@map("project_api_key")
}

model McpIdentity {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdById    String
  createdBy      User     @relation("McpIdentityCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  grants         McpIdentityResourceGrant[]
  apiKeys        ProjectApiKey[]

  @@index([organizationId])
  @@map("mcp_identity")
}

model McpIdentityResourceGrant {
  id            String      @id @default(cuid())
  mcpIdentityId String
  mcpIdentity   McpIdentity @relation(fields: [mcpIdentityId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resourceType  String      // "context" | "instruction" | "skill" | "prompt_template" | "checklist" | "agent_profile"
  resourceId    String
  createdAt     DateTime    @default(now())

  @@unique([mcpIdentityId, projectId, resourceType, resourceId])
  @@index([mcpIdentityId, projectId])
  @@index([projectId])
  @@map("mcp_identity_resource_grant")
}

model McpRequestLog {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mcpIdentityId String
  apiKeyId      String
  receivedAt    DateTime  @default(now())
  respondedAt   DateTime? // set only if the server successfully sent a response back

  @@index([projectId, receivedAt])
  @@map("mcp_request_log")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("contact_messages")
}
